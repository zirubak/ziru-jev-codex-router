#!/usr/bin/env node
import { spawn } from 'node:child_process';
import { createHash } from 'node:crypto';
import { readFileSync, lstatSync, realpathSync } from 'node:fs';
import { isAbsolute } from 'node:path';
import { fileURLToPath } from 'node:url';
import { connectDesktopBridge } from '../src/desktop-provider-bridge.mjs';

const bundledNative = '/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex';
let nativeBinary = bundledNative;
let provider;
try {
  const file = process.env.JEV_DESKTOP_CONFIG;
  if (!file || !isAbsolute(file)) throw new Error('Missing private bridge manifest');
  const stat = lstatSync(file);
  if (!stat.isFile() || stat.isSymbolicLink() || stat.uid !== process.getuid?.() || (stat.mode & 0o077)) {
    throw new Error('Unsafe manifest permissions');
  }
  const manifest = JSON.parse(readFileSync(file, 'utf8'));
  if (manifest.version !== 1 || !isAbsolute(manifest.nativeBinary)
      || realpathSync(manifest.nativeBinary) === realpathSync(fileURLToPath(import.meta.url))) {
    throw new Error('Invalid native executable');
  }
  // Never accept a network destination from the Desktop model list or RPCs.
  if (!['http://127.0.0.1:4202/v1', 'http://localhost:4202/v1'].includes(manifest.provider?.base_url)
      || manifest.provider?.wire_api !== 'responses' || manifest.provider?.requires_openai_auth !== false) {
    throw new Error('Invalid isolated Jev provider');
  }
  nativeBinary = manifest.nativeBinary;
  // Updater helpers can retain the launch environment and respawn this adapter.
  // Recheck both identities here, not just when the application was launched.
  if (!isAbsolute(manifest.appAsar ?? '')
      || !/^[a-f0-9]{64}$/.test(manifest.expectedAppSha256 ?? '')
      || !/^[a-f0-9]{64}$/.test(manifest.expectedNativeSha256 ?? '')
      || createHash('sha256').update(readFileSync(manifest.appAsar)).digest('hex') !== manifest.expectedAppSha256
      || createHash('sha256').update(readFileSync(nativeBinary)).digest('hex') !== manifest.expectedNativeSha256) {
    throw new Error('Application update requires bridge revalidation');
  }
  provider = manifest.provider;
} catch {
  process.stderr.write('Jev Desktop integration unavailable; using unmodified native Codex.\n');
}
const args = process.argv.slice(2);
const adapted = provider && args.includes('app-server') && !args.includes('--help');
const env = { ...process.env };
delete env.CODEX_CLI_PATH;
delete env.CODEX_APP_SERVER_USE_LOCAL_DAEMON;
delete env.JEV_DESKTOP_CONFIG;
const child = spawn(nativeBinary, args, { env, stdio: adapted ? ['pipe', 'pipe', 'inherit'] : 'inherit' });
if (adapted) connectDesktopBridge({ input: process.stdin, output: process.stdout, child, provider });
for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(signal, () => child.kill(signal));
child.on('error', () => {
  process.stderr.write('Unable to start the native Codex executable.\n');
  process.exitCode = 1;
});
child.on('exit', (code) => { process.exitCode = code ?? 1; });
