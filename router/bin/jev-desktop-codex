#!/usr/bin/env node
import { spawn } from 'node:child_process';
import os from 'node:os';
import path from 'node:path';
import { connectDesktopBridge } from '../src/desktop-provider-bridge.mjs';
import { PrivateRouteState } from '../src/desktop-provider-state.mjs';
import { DesktopContractMismatch, qualifyDesktop } from '../src/desktop-compatibility.mjs';
import { isStdioAppServer, readDesktopManifest } from '../src/desktop-runtime.mjs';

const bundledNative = '/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex';
const args = process.argv.slice(2);
let nativeBinary = bundledNative;
let provider;
let state;
if (isStdioAppServer(args)) {
  try {
    const file = process.env.JEV_DESKTOP_CONFIG;
    const manifest = readDesktopManifest(file, process.env.CODEX_HOME ?? path.join(os.homedir(), '.codex'));
    nativeBinary = manifest.nativeBinary;
    // The updater can respawn this executable without running our app launcher.
    await qualifyDesktop({ app: manifest.app, cacheDirectory: path.join(path.dirname(file), 'qualifications') });
    state = new PrivateRouteState(manifest.routeStateDirectory);
    provider = manifest.provider;
  } catch (error) {
    if (!(error instanceof DesktopContractMismatch)) throw error;
    process.stderr.write('Jev Desktop could not verify compatibility. Existing chats remain readable; Jev requests require reconnection through Jev Codex.command.\n');
  }
}
const adapted = Boolean(provider);
const env = { ...process.env };
delete env.CODEX_CLI_PATH;
delete env.CODEX_APP_SERVER_USE_LOCAL_DAEMON;
delete env.JEV_DESKTOP_CONFIG;
const child = spawn(nativeBinary, args, { env, stdio: adapted ? ['pipe', 'pipe', 'inherit'] : 'inherit' });
if (adapted) connectDesktopBridge({ input: process.stdin, output: process.stdout, child, provider, state });
for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(signal, () => child.kill(signal));
child.on('error', () => {
  process.stderr.write('Unable to start the native Codex executable.\n');
  process.exitCode = 1;
});
child.on('exit', (code) => { process.exitCode = code ?? 1; });
